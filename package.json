{
  "name": "llm-survey",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:status": "tsx scripts/db-status.ts",
    "migrate:production": "node scripts/migrate-production.mjs",
    "start:production": "node scripts/start-production.mjs",
    "export:csv": "tsx scripts/export-csv.ts",
    "export:quality": "tsx scripts/export-quality.ts",
    "retention:cleanup": "tsx scripts/retention-cleanup.ts",
    "infra:synth": "cdk synth",
    "infra:diff": "cdk diff",
    "infra:deploy:ecr": "cdk deploy LlmSurveyEcrStack",
    "infra:deploy:app": "cdk deploy LlmSurveyProdStack",
    "prod:image:push": "node scripts/prod-push-image.mjs",
    "prod:dns:alias": "node scripts/prod-upsert-dns-alias.mjs",
    "test:backend": "vitest run tests/backend/unit.test.ts tests/backend/export.test.ts tests/backend/finalization.test.ts",
    "test:backend:db": "vitest run tests/backend/db.test.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f app db migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^15.3.3",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/env": "15.5.18",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "aws-cdk": "^2.1125.0",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
